{
  "name": "hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint --type-aware && pnpm --filter @hub/web lint:tokens",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "git config core.hooksPath .githooks",
    "test:e2e": "pnpm --filter @hub/e2e e2e",
    "test:e2e:update": "pnpm --filter @hub/e2e e2e:update",
    "verify": "pnpm check && pnpm test:e2e",
    "smoke": "pnpm --filter @hub/server smoke"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "7.0.2"
  }
}
