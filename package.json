{
  "name": "hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node scripts/run-tests.ts \"deploy/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "lint": "oxlint --type-aware --deny-warnings && pnpm --filter @hub/web lint:tokens",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:modules": "node scripts/check-modules.ts --write",
    "guard": "node scripts/guard-private.ts && node scripts/guard-modules.ts",
    "check": "pnpm guard && pnpm typecheck && pnpm check:modules && pnpm lint && pnpm format:check && pnpm test",
    "check:modules": "node scripts/check-modules.ts",
    "prepare": "git config core.hooksPath .githooks",
    "test:e2e": "node scripts/test-e2e.ts",
    "test:e2e:private": "node scripts/test-e2e-private.ts",
    "test:e2e:update": "pnpm --filter @hub/e2e e2e:update && HUB_EXAMPLE_MODULES=1 pnpm --filter @hub/e2e e2e:update",
    "verify": "node scripts/verify.ts",
    "smoke": "pnpm --filter @hub/server smoke",
    "serve": "pnpm --filter @hub/web build && pnpm --filter @hub/server start",
    "desktop:install": "node deploy/install.ts",
    "assistant:eval": "node apps/server/src/assistant-eval.ts"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "7.0.2"
  }
}
