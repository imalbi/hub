{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "it",
  "locales": ["it"],
  "modules": ["https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4.5.0/dist/index.js"],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}.json",
      "./src/modules/audio/messages/{locale}.json",
      "./src/modules/media/messages/{locale}.json",
      "./src/modules/devices/messages/{locale}.json",
      "./src/modules/pomodoro/messages/{locale}.json",
      "./src/modules/theme/messages/{locale}.json",
      "./src/modules/system/messages/{locale}.json",
      "./src/modules/notes/messages/{locale}.json",
      "./src/modules/calendar/messages/{locale}.json"
    ]
  }
}
