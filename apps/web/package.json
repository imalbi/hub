{
  "name": "@hub/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "pnpm i18n && tsr generate && tsc -p .",
    "test": "node --test 'src/**/*.test.ts'",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "lint:tokens": "! rg -n '(^|[\" :])(-?[a-z]+(-[a-z]+)*)-\\[' src --glob '*.tsx' --glob '!src/paraglide/**' --glob '!src/components/ui/**'"
  },
  "dependencies": {
    "@fontsource-variable/urbanist": "^5.3.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@trpc/client": "^11.23.0",
    "@trpc/server": "^11.23.0",
    "@trpc/tanstack-react-query": "^11.23.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@hub/server": "workspace:*",
    "@inlang/paraglide-js": "^3.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
