  "agents_local_summary": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} chiamata oggi, ultima {action} {when}",
        "countPlural=*": "{count} chiamate oggi, ultima {action} {when}"
      }
    }
  ],
  "devices_access_count": [
    {
      "declarations": [
        "input devices",
        "input agents",
        "local devicesPlural = devices: plural",
        "local agentsPlural = agents: plural"
      ],
      "selectors": ["devicesPlural", "agentsPlural"],
      "match": {
        "devicesPlural=one, agentsPlural=one": "{devices} dispositivo, {agents} agent remoto",
        "devicesPlural=one, agentsPlural=*": "{devices} dispositivo, {agents} agent remoti",
        "devicesPlural=*, agentsPlural=one": "{devices} dispositivi, {agents} agent remoto",
        "devicesPlural=*, agentsPlural=*": "{devices} dispositivi, {agents} agent remoti"
      }
    }
  ],
