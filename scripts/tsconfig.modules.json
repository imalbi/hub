{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "react", "react-dom"],
    "typeRoots": ["../apps/server/node_modules/@types", "../apps/web/node_modules/@types"],
    "paths": {
      "@/*": ["../apps/web/src/*"],
      "@tanstack/react-router": ["../apps/web/node_modules/@tanstack/react-router"],
      "@tanstack/react-query": ["../apps/web/node_modules/@tanstack/react-query"],
      "@phosphor-icons/react": ["../apps/web/node_modules/@phosphor-icons/react"],
      "motion/react": ["../apps/web/node_modules/motion/react"],
      "motion": ["../apps/web/node_modules/motion"],
      "rough-notation": ["../apps/web/node_modules/rough-notation"]
    }
  }
}
