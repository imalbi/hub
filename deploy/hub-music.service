[Unit]
Description=Hub music player

StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
UMask=0077
NoNewPrivileges=yes
TimeoutStopSec=20
# YouTube stream URLs answer 403 for about 5 s after yt-dlp resolves them; ffmpeg retries until they open.
ExecStart=/usr/bin/mpv --idle=yes --no-video --input-ipc-server=%t/hub-music.sock --ytdl-format=bestaudio --stream-lavf-o=reconnect=1,reconnect_on_http_error=403,reconnect_delay_max=8
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
